<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.ipollusen.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.ipollusen.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_assistant"
        android:name="com.example.ipollusen.ui.assistant.AssistantFragment"
        android:label="@string/title_assistant"
        tools:layout="@layout/fragment_assistant" />


    <fragment
        android:id="@+id/navigation_map"
        android:name="com.example.ipollusen.MapsFragment"
        android:label="@string/title_map"
        tools:layout="@layout/fragment_maps" />




    <fragment
        android:id="@+id/nav_logout"
        android:name="com.example.ipollusen.LogoutFragment"
        android:label="@string/menu_slideshow"
        tools:layout="@layout/fragment_logout" />
    <fragment
        android:id="@+id/navigation_bluetooth"
        android:name="com.example.ipollusen.BluetoothFragment"
        android:label="Bluetooth"
        tools:layout="@layout/fragment_bluetooth" />


</navigation>
