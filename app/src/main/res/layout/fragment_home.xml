<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Existing Air Quality Indicator Section -->
            <LinearLayout
                android:id="@+id/airQualityStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_smiley_good"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOOD"
                    android:textSize="20sp"
                    android:textColor="@color/md_theme_light_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Exposure Card Section with Charts -->
            <androidx.cardview.widget.CardView
                android:id="@+id/exposureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/md_theme_light_secondaryContainer">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/exposureTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exposure at a Glance"
                        android:textSize="18sp"
                        android:textColor="@color/md_theme_light_onSecondaryContainer"
                        android:fontFamily="sans-serif-medium"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="8dp"/>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp">
                            <!-- Existing Bar Charts for Pollutants -->
                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartPM1"
                                android:layout_width="100dp"
                                android:layout_height="250dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/custom_barchart_pm1"
                                android:contentDescription="PM1 Chart"/>

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartPM2_5"
                                android:layout_width="100dp"
                                android:layout_height="250dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/custom_barchart_pm2_5"
                                android:contentDescription="PM2.5 Chart"/>

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartPM10"
                                android:layout_width="100dp"
                                android:layout_height="250dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/custom_barchart_pm10"
                                android:contentDescription="PM10 Chart"/>

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartCO"
                                android:layout_width="100dp"
                                android:layout_height="250dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/custom_barchart_co"
                                android:contentDescription="CO Chart"/>

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartNO2"
                                android:layout_width="100dp"
                                android:layout_height="250dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/custom_barchart_no2"
                                android:contentDescription="NO2 Chart"/>

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartVOC"
                                android:layout_width="100dp"
                                android:layout_height="250dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/custom_barchart_voc"
                                android:contentDescription="VOC Chart"/>

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartC2H5OH"
                                android:layout_width="100dp"
                                android:layout_height="250dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/custom_barchart_c2h5oh"
                                android:contentDescription="C2H5OH Chart"/>

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartTemperature"
                                android:layout_width="100dp"
                                android:layout_height="250dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/custom_barchart_temperature"
                                android:contentDescription="Temperature Chart"/>

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartHumidity"
                                android:layout_width="100dp"
                                android:layout_height="250dp"
                                android:background="@drawable/custom_barchart_humidity"
                                android:contentDescription="Humidity Chart"/>
                        </LinearLayout>
                    </HorizontalScrollView>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Insights Section with Pie and Line Charts -->
            <androidx.cardview.widget.CardView
                android:id="@+id/insightsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:backgroundTint="@color/md_theme_light_secondaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/exposureTitle1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Insights"
                        android:textSize="18sp"
                        android:textColor="@color/md_theme_light_onSecondaryContainer"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="16dp"/>

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/PieChart"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginBottom="16dp"/>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChart"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginBottom="16dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bluetooth Fragment Layout -->

            <!-- Advanced View (MQTT) Fragment Layout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="632dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/statusTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textSize="18sp"
                    android:textColor="@android:color/holo_red_light"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/scanButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/readButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Read"
                    android:layout_marginBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/label1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Text for Label1"
                    android:layout_marginTop="8dp" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1"
                    android:layout_marginTop="8dp">

                    <TableRow>
                        <TextView android:text="Temperature" android:padding="4dp"/>
                        <TextView android:id="@+id/temp_value" android:text="000" android:padding="4dp" android:background="@android:color/black" android:textColor="@android:color/holo_green_light"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="Humidity" android:padding="4dp"/>
                        <TextView android:id="@+id/hum_value" android:text="000" android:padding="4dp" android:background="@android:color/black" android:textColor="@android:color/holo_green_light"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="NO2" android:padding="4dp"/>
                        <TextView android:id="@+id/no2_value" android:text="000" android:padding="4dp" android:background="@android:color/black" android:textColor="@android:color/holo_green_light"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="C2H5OH" android:padding="4dp"/>
                        <TextView android:id="@+id/c2h5oh_value" android:text="000" android:padding="4dp" android:background="@android:color/black" android:textColor="@android:color/holo_green_light"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="VOC" android:padding="4dp"/>
                        <TextView android:id="@+id/voc_value" android:text="000" android:padding="4dp" android:background="@android:color/black" android:textColor="@android:color/holo_green_light"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="CO" android:padding="4dp"/>
                        <TextView android:id="@+id/co_value" android:text="000" android:padding="4dp" android:background="@android:color/black" android:textColor="@android:color/holo_green_light"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="PM1" android:padding="4dp"/>
                        <TextView android:id="@+id/pm1_value" android:text="000" android:padding="4dp" android:background="@android:color/black" android:textColor="@android:color/holo_green_light"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="PM2.5" android:padding="4dp"/>
                        <TextView android:id="@+id/pm2_value" android:text="000" android:padding="4dp" android:background="@android:color/black" android:textColor="@android:color/holo_green_light"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="PM10" android:padding="4dp"/>
                        <TextView android:id="@+id/pm10_value" android:text="000" android:padding="4dp" android:background="@android:color/black" android:textColor="@android:color/holo_green_light"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="TEST" android:padding="4dp"/>
                        <TextView android:id="@+id/test_value" android:text="000" android:padding="4dp" android:background="@android:color/black" android:textColor="@android:color/holo_green_light"/>
                    </TableRow>
                </TableLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/textViewStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MQTT Status"
                    android:textSize="18sp"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/editTextTopic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Enter Topic"
                    android:minHeight="48dp"/>

                <TextView
                    android:id="@+id/editTextMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Enter Message"
                    android:minHeight="48dp"/>

                <Button
                    android:id="@+id/buttonPublish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Publish"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/textViewReceivedMessages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Received Messages"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
