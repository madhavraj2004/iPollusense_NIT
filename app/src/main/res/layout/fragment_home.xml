<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Device Card Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/DeviceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                android:layout_margin="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/deviceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Device 2617(Static Indoor)"
                        android:textSize="16sp"
                        android:textColor="@android:color/black" />

                    <ImageView
                        android:id="@+id/dropdownIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_dropdown_arrow"
                        android:layout_alignParentEnd="true"
                        android:contentDescription="Dropdown Icon" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/deviceRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>




            <!-- Data Type Card Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/DataTypeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:backgroundTint="@color/md_theme_light_secondaryContainer">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- LIVE Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/liveButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="#0078D7"
                            android:fontFamily="sans-serif-medium"
                            android:padding="12dp"
                            android:stateListAnimator="@null"
                            android:text="LIVE"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            app:cornerRadius="12dp"
                            app:elevation="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pick_date_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="#005BBB"
                            android:fontFamily="sans-serif-medium"
                            android:padding="12dp"
                            android:stateListAnimator="@null"
                            android:text="HISTORICAL"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            app:cornerRadius="12dp"
                            app:elevation="4dp"
                            app:icon="@drawable/ic_baseline_add_to_photos_24" /> <!-- Remove ripple effect for cleaner appearance -->


                    </LinearLayout>

                    <TextView
                        android:id="@+id/show_selected_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="128dp"
                        android:text="Selected Date is : "
                        android:textSize="18sp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>




            <!-- Existing Air Quality Indicator Section -->
            <LinearLayout
                android:id="@+id/airQualityStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_smiley_good" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="GOOD"
                    android:textColor="@color/md_theme_light_primary"
                    android:textSize="20sp" />
            </LinearLayout>


            <!-- Exposure at a Glance Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/exposureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/md_theme_light_secondaryContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/exposureTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Exposure at a Glance"
                        android:textColor="@color/md_theme_light_onSecondaryContainer"
                        android:textSize="18sp" />

                    <!-- Line Plot Graph (replace with actual chart view) -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/exposureLineChart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_below="@id/exposureTitle"
                        android:layout_marginTop="16dp"/>

                    <!-- Horizontal ScrollView for checkboxes -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/exposureLineChart"
                        android:layout_marginTop="8dp">

                        <!-- Horizontal LinearLayout for checkboxes -->
                        <LinearLayout
                            android:id="@+id/sensorCheckboxLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Temperature checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxTemperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Temperature"
                                android:checked="true" />

                            <!-- Humidity checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxHumidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Humidity"
                                android:checked="true" />

                            <!-- Pressure checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxPressure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pressure"
                                android:checked="true" />

                            <!-- PM1 checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxPM1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PM1"
                                android:checked="false" />

                            <!-- PM2.5 checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxPM2_5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PM2.5"
                                android:checked="false" />

                            <!-- PM10 checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxPM10"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PM10"
                                android:checked="false" />

                            <!-- CO checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxCO"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CO"
                                android:checked="false" />

                            <!-- VOC checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxVOC"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VOC"
                                android:checked="false" />

                            <!-- CO2 checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxCO2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CO2"
                                android:checked="false" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>




            <!-- Predictions Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/PredictionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/md_theme_light_secondaryContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Title TextView -->
                    <TextView
                        android:id="@+id/PredictionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Predictions"
                        android:textColor="@color/md_theme_light_onSecondaryContainer"
                        android:textSize="18sp" />

                    <!-- BarPlot (Placeholder for actual chart view) -->
                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/predictionBarChart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_below="@id/PredictionTitle"
                        android:layout_marginTop="16dp"/>

                    <!-- Checkboxes for Dust and CO below the BarPlot -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_below="@id/predictionBarChart"
                        android:layout_marginTop="8dp">

                        <!-- Dust checkbox -->
                        <CheckBox
                            android:id="@+id/checkboxpredictionDust"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dust"
                            android:checked="false"/>

                        <!-- CO checkbox -->
                        <CheckBox
                            android:id="@+id/checkboxpredictionCO"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CO"
                            android:checked="false"/>
                    </LinearLayout>

                    <!-- Checkboxes for Model, Predicted, Calculated to the right of BarPlot -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="16dp">



                        <!-- Predicted checkbox -->
                        <CheckBox
                            android:id="@+id/checkboxPredicted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Predicted"
                            android:checked="true"/>

                        <!-- Calculated checkbox -->
                        <CheckBox
                            android:id="@+id/checkboxLive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live"
                            android:checked="true"/>
                    </LinearLayout>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>


            <!-- Map Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/MapCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/md_theme_light_secondaryContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="400dp"
                    android:layout_height="446dp"
                    android:padding="16dp">

                    <!-- Map Title -->
                    <TextView
                        android:id="@+id/MapTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Map"
                        android:textColor="@color/md_theme_light_onSecondaryContainer"
                        android:textSize="18sp" />


                    <!-- Enlarge Button (Overlayed on top of MapView) -->
                    <org.osmdroid.views.MapView
                        android:id="@+id/mapView"
                        android:layout_width="364dp"
                        android:layout_height="338dp"
                        android:layout_below="@id/MapTitle"
                        android:layout_marginTop="53dp"
                        android:contentDescription="Map displaying location and surrounding area" />

                    <TextView
                        android:id="@+id/tv_coordinates"
                        android:layout_width="206dp"
                        android:layout_height="65dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="43dp"
                        android:layout_toStartOf="@+id/enlargeButton"
                        android:padding="8dp"
                        android:text="Coordinates: "
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/enlargeButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:background="@android:color/transparent"
                        android:contentDescription="Enlarge Map"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_zoom_in" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <!-- Live Feed Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/LiveCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#D4E4F9">

                <RelativeLayout
                    android:layout_width="363dp"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/LiveTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Live Feed"
                        android:textColor="@color/black"
                        android:textSize="18sp" />
                    <!-- Line Plot Graph for Live Data -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/LiveLineChart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_below="@id/LiveTitle"
                        android:layout_marginTop="16dp" />


                    <!-- Horizontal ScrollView for checkboxes -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/LiveLineChart"
                        android:layout_marginTop="8dp">

                        <!-- Horizontal LinearLayout for checkboxes -->
                        <LinearLayout
                            android:id="@+id/LiveCheckboxLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Add checkboxes as needed -->
                            <CheckBox
                                android:id="@+id/LivecheckboxTemperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Temperature" />

                            <CheckBox
                                android:id="@+id/LivecheckboxHumidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Humidity" />

                            <CheckBox
                                android:id="@+id/LivecheckboxPressure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Pressure" />

                            <CheckBox
                                android:id="@+id/LivecheckboxPM1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="PM1" />

                            <CheckBox
                                android:id="@+id/LivecheckboxPM2_5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="PM2.5" />

                            <CheckBox
                                android:id="@+id/LivecheckboxPM10"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="PM10" />

                            <CheckBox
                                android:id="@+id/LivecheckboxCO"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="CO" />

                            <CheckBox
                                android:id="@+id/LivecheckboxVOC"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="VOC" />

                            <CheckBox
                                android:id="@+id/LivecheckboxCO2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="CO2" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/mqttCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#D4E4F9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="460dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Status Display -->
                    <TextView
                        android:id="@+id/textViewStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="16dp"
                        android:text="MQTT Status"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/editTextTopic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Enter Topic"
                        android:minHeight="48dp" />

                    <EditText
                        android:id="@+id/editTextMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Enter Message"
                        android:minHeight="48dp" />

                    <!-- Publish Button -->
                    <Button
                        android:id="@+id/buttonPublish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:text="Publish" />

                    <!-- Received Messages Label -->
                    <TextView
                        android:id="@+id/textViewReceivedMessagesLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Received Messages"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- ScrollView for Received Messages -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/textViewReceivedMessages"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="..."
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </ScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/bleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#D4E4F9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="686dp"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/statusTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Status"
                        android:textColor="@android:color/holo_red_light"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/scanButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Scan" />

                    <Button
                        android:id="@+id/connectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Connect" />

                    <Button
                        android:id="@+id/exportButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Export CSV"
                        android:layout_marginBottom="16dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="16dp" />
                    <TextView
                        android:id="@+id/dbmessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="for db" />
                    <TextView
                        android:id="@+id/label1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Text for Label1" />

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="322dp"
                        android:layout_marginTop="8dp"
                        android:stretchColumns="1">

                        <TableRow>

                            <TextView
                                android:padding="4dp"
                                android:text="Temperature" />

                            <TextView
                                android:id="@+id/temp_value"
                                android:background="@android:color/black"
                                android:padding="4dp"
                                android:text="000"
                                android:textColor="@android:color/holo_green_light" />
                        </TableRow>

                        <TableRow>

                            <TextView
                                android:padding="4dp"
                                android:text="Humidity" />

                            <TextView
                                android:id="@+id/hum_value"
                                android:background="@android:color/black"
                                android:padding="4dp"
                                android:text="000"
                                android:textColor="@android:color/holo_green_light" />
                        </TableRow>


                        <TableRow>

                            <TextView
                                android:padding="4dp"
                                android:text="PRESS." />

                            <TextView
                                android:id="@+id/press_value"
                                android:background="@android:color/black"
                                android:padding="4dp"
                                android:text="000"
                                android:textColor="@android:color/holo_green_light" />
                        </TableRow>


                        <TableRow>

                            <TextView
                                android:padding="4dp"
                                android:text="PM1" />

                            <TextView
                                android:id="@+id/pm1_value"
                                android:background="@android:color/black"
                                android:padding="4dp"
                                android:text="000"
                                android:textColor="@android:color/holo_green_light" />
                        </TableRow>

                        <TableRow>

                            <TextView
                                android:padding="4dp"
                                android:text="PM2.5" />

                            <TextView
                                android:id="@+id/pm2_value"
                                android:background="@android:color/black"
                                android:padding="4dp"
                                android:text="000"
                                android:textColor="@android:color/holo_green_light" />
                        </TableRow>

                        <TableRow>

                            <TextView
                                android:padding="4dp"
                                android:text="PM10" />

                            <TextView
                                android:id="@+id/pm10_value"
                                android:background="@android:color/black"
                                android:padding="4dp"
                                android:text="000"
