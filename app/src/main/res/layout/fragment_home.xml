<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:elevation="4dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Status TextView -->

                    <!-- Export CSV Button -->
                    <TextView
                        android:id="@+id/statusTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status"
                        android:textColor="@android:color/holo_red_light"
                        android:textSize="18sp" />



                </LinearLayout>

            </androidx.cardview.widget.CardView>




            <androidx.cardview.widget.CardView
                android:id="@+id/DeviceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Dropdown for Device Selection -->
                    <Spinner
                        android:id="@+id/deviceDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:prompt="@string/select_device" />


                    <!-- Add New Device Flow -->
                    <LinearLayout
                        android:id="@+id/addDeviceLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">



                        <Button
                            android:id="@+id/bluetoothOption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bluetooth" />

                        <Button
                            android:id="@+id/mqttOption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="MQTT" />

                        <Button
                            android:id="@+id/cancelOption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cancel" />
                    </LinearLayout>

                    <!-- MQTT Device ID Entry -->
                    <LinearLayout
                        android:id="@+id/mqttDeviceLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:text="Enter Device ID:"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <EditText
                            android:id="@+id/deviceIdInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Device ID" />

                        <Button
                            android:id="@+id/okButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OK" />

                        <Button
                            android:id="@+id/backButtonMqtt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Back" />
                    </LinearLayout>

                    <!-- Bluetooth Device List -->
                    <LinearLayout
                        android:id="@+id/bluetoothDeviceLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:text="List of Devices:"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <!-- NestedScrollView to make only the RecyclerView scrollable -->
                        <androidx.core.widget.NestedScrollView
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:fillViewport="true">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/bluetoothRecyclerView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="true" />
                        </androidx.core.widget.NestedScrollView>

                        <Button
                            android:id="@+id/scanButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SCAN" />

                        <Button
                            android:id="@+id/backButtonBluetooth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Back" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Data Type Card Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/DataTypeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:backgroundTint="@color/md_theme_light_secondaryContainer">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- LIVE Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/liveButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="#0078D7"
                            android:fontFamily="sans-serif-medium"
                            android:padding="12dp"
                            android:stateListAnimator="@null"
                            android:text="LIVE"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            app:cornerRadius="12dp"
                            app:elevation="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pick_date_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="#005BBB"
                            android:fontFamily="sans-serif-medium"
                            android:padding="12dp"
                            android:stateListAnimator="@null"
                            android:text="HISTORICAL"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            app:cornerRadius="12dp"
                            app:elevation="4dp"
                            app:icon="@drawable/ic_baseline_add_to_photos_24" /> <!-- Remove ripple effect for cleaner appearance -->


                    </LinearLayout>

                    <TextView
                        android:id="@+id/show_selected_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="128dp"
                        android:text="Selected Date is : "
                        android:textSize="18sp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>




            <!-- Existing Air Quality Indicator Section -->
            <LinearLayout
                android:id="@+id/airQualityStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_smiley_good" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="GOOD"
                    android:textColor="@color/md_theme_light_primary"
                    android:textSize="20sp" />
            </LinearLayout>


            <!-- Exposure at a Glance Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/exposureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/md_theme_light_secondaryContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/exposureTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Exposure at a Glance"
                        android:textColor="@color/md_theme_light_onSecondaryContainer"
                        android:textSize="18sp" />

                    <!-- Line Plot Graph (replace with actual chart view) -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/exposureLineChart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_below="@id/exposureTitle"
                        android:layout_marginTop="16dp"/>

                    <!-- Horizontal ScrollView for checkboxes -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/exposureLineChart"
                        android:layout_marginTop="8dp">

                        <!-- Horizontal LinearLayout for checkboxes -->
                        <LinearLayout
                            android:id="@+id/sensorCheckboxLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Temperature checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxTemperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Temperature"
                                android:checked="true" />

                            <!-- Humidity checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxHumidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Humidity"
                                android:checked="true" />

                            <!-- Pressure checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxPressure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pressure"
                                android:checked="true" />

                            <!-- PM1 checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxPM1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PM1"
                                android:checked="false" />

                            <!-- PM2.5 checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxPM2_5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PM2.5"
                                android:checked="false" />

                            <!-- PM10 checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxPM10"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PM10"
                                android:checked="false" />

                            <!-- CO checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxCO"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CO"
                                android:checked="false" />

                            <!-- VOC checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxVOC"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VOC"
                                android:checked="false" />

                            <!-- CO2 checkbox -->
                            <CheckBox
                                android:id="@+id/checkboxCO2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CO2"
                                android:checked="false" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>




            <!-- Predictions Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/PredictionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/md_theme_light_secondaryContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Title TextView -->
                    <TextView
                        android:id="@+id/PredictionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Predictions"
                        android:textColor="@color/md_theme_light_onSecondaryContainer"
                        android:textSize="18sp" />

                    <!-- BarPlot (Placeholder for actual chart view) -->
                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/predictionBarChart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_below="@id/PredictionTitle"
                        android:layout_marginTop="16dp"/>

                    <!-- Checkboxes for Dust and CO below the BarPlot -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_below="@id/predictionBarChart"
                        android:layout_marginTop="8dp">

                        <!-- Dust checkbox -->
                        <CheckBox
                            android:id="@+id/checkboxpredictionDust"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dust"
                            android:checked="false"/>

                        <!-- CO checkbox -->
                        <CheckBox
                            android:id="@+id/checkboxpredictionCO"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CO"
                            android:checked="false"/>
                    </LinearLayout>

                    <!-- Checkboxes for Model, Predicted, Calculated to the right of BarPlot -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="16dp">



                        <!-- Predicted checkbox -->
                        <CheckBox
                            android:id="@+id/checkboxPredicted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Predicted"
                            android:checked="true"/>

                        <!-- Calculated checkbox -->
                        <CheckBox
                            android:id="@+id/checkboxLive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live"
                            android:checked="true"/>
                    </LinearLayout>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>



            <!-- Live Feed Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/LiveCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#D4E4F9">

                <RelativeLayout
                    android:layout_width="363dp"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/LiveTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Live Feed"
                        android:textColor="@color/black"
                        android:textSize="18sp" />
                    <!-- Line Plot Graph for Live Data -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/LiveLineChart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_below="@id/LiveTitle"
                        android:layout_marginTop="16dp" />


                    <!-- Horizontal ScrollView for checkboxes -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/LiveLineChart"
                        android:layout_marginTop="8dp">

                        <!-- Horizontal LinearLayout for checkboxes -->
                        <LinearLayout
                            android:id="@+id/LiveCheckboxLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Add checkboxes as needed -->
                            <CheckBox
                                android:id="@+id/LivecheckboxTemperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Temperature" />

                            <CheckBox
                                android:id="@+id/LivecheckboxHumidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Humidity" />

                            <CheckBox
                                android:id="@+id/LivecheckboxPressure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Pressure" />

                            <CheckBox
                                android:id="@+id/LivecheckboxPM1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="PM1" />

                            <CheckBox
                                android:id="@+id/LivecheckboxPM2_5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="PM2.5" />

                            <CheckBox
                                android:id="@+id/LivecheckboxPM10"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="PM10" />

                            <CheckBox
                                android:id="@+id/LivecheckboxCO"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="CO" />

                            <CheckBox
                                android:id="@+id/LivecheckboxVOC"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="VOC" />

                            <CheckBox
                                android:id="@+id/LivecheckboxCO2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="CO2" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>






        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>