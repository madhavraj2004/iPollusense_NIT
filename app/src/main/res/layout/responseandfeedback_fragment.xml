<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Room Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvRoomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Study Room"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

                <TextView
                    android:id="@+id/tvRoomDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Well lit and comfortable"
                    android:textSize="16sp"
                    android:textColor="#424242"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvRoomDimensions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Size: 5m x 6m"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Location Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvLocationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

                <TextView
                    android:id="@+id/tvLocationAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Satyen Bose Hall of Residence for Boys, Steel Park More, Durgapur, ..."
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvCoordinates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lat: 23.5428477, Long: 87.3441273"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Weather Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvWeatherTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weather Conditions"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

                <TextView
                    android:id="@+id/tvWeatherDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temp: 37°C, Humidity: 27%, Wind: 5.8 m/s"
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvWeatherDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cloud Cover: 40%, Pressure: 997.2 hPa"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Appliances Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvAppliancesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appliances"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

                <!-- Appliance: Fan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#f9f9f9"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:radius="4dp">

                    <TextView
                        android:id="@+id/tvFanTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tvFanState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="State: ON"
                        android:textSize="14sp"
                        android:textColor="#424242"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvFanSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Speed: 62%"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Appliance: AC -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#f9f9f9"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp"
                    android:radius="4dp">

                    <TextView
                        android:id="@+id/tvACTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AC"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tvACState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="State: ON"
                        android:textSize="14sp"
                        android:textColor="#424242"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvACTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temperature: 18°C"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvACSwing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Swing: Not Provided"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvACMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode: Cool"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvACFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filter Installed: Not Provided"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recommendations Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvRecTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recommendations"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

                <TextView
                    android:id="@+id/tvRoomOptimal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room Optimal: YES"
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvRationale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rationale: Hey Madhav, it's great to see that the conditions in your study room are still comfortable!"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvOtherSuggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Other Suggestions: Stay hydrated and consider a glass of lemonade."
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvRecheckAfter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recheck After: 20 mins"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
