<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">


    <EditText
        android:id="@+id/inputRoomName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:drawable/editbox_background"
        android:hint="Enter Room Name"
        android:minHeight="48dp"
        android:padding="8dp" />

    <EditText
        android:id="@+id/inputRoomDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Room Description"
        android:minHeight="48dp" />


    <EditText
        android:id="@+id/inputLength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Room Length"
        android:inputType="numberDecimal"
        android:minHeight="48dp" />

    <EditText
        android:id="@+id/inputBreadth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Room Breadth"
        android:inputType="numberDecimal"
        android:minHeight="48dp" />

    <EditText
        android:id="@+id/inputNodeIds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Node IDs"
        android:inputType="text"
        android:minHeight="48dp" />

    <Button
        android:id="@+id/btnAddAppliance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Appliance"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAppliances"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Room"/>
</LinearLayout>
