<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feedbackScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:id="@+id/feedbackRootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:divider="?android:attr/dividerHorizontal"
        android:showDividers="middle"
        android:dividerPadding="8dp">

        <!-- Title -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/applianceStatesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appliance States"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:textColor="?attr/colorPrimary" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- No Data -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/noDataTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:text="No room data available"
            android:textSize="16sp"
            android:textColor="?android:textColorSecondary"
            android:gravity="center" />

        <!-- Appliance State Container (Cards will be added programmatically) -->
        <LinearLayout
            android:id="@+id/applianceStateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <!-- Rationale Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?android:attr/colorBackground">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/rationaleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Rationale: "
                android:textSize="16sp"
                android:textStyle="italic"
                android:textColor="?android:textColorPrimary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Other Suggestions Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?android:attr/colorBackground">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/otherSuggestionsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Other Suggestions: "
                android:textSize="16sp"
                android:textStyle="italic"
                android:textColor="?android:textColorPrimary" />
        </com.google.android.material.card.MaterialCardView>


        <!-- Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendRecommendationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Recommendation"
            app:cornerRadius="12dp"
            style="@style/Widget.Material3.Button"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
