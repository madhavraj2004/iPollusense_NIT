<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
        <!-- Base Application Theme -->
        <style name="Theme.iPolluSen" parent="Theme.Material3.Light.NoActionBar">
                <item name="colorPrimary">@color/md_theme_light_primary</item>
                <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
                <item name="colorSecondary">@color/md_theme_light_secondary</item>
                <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
                <item name="android:statusBarColor">@color/md_theme_light_primary</item>
                <item name="android:navigationBarColor">@color/md_theme_light_background</item>
        </style>

        <!-- Style for Status Indicators -->
        <style name="StatusText">
                <item name="android:layout_gravity">center</item>
                <item name="android:textSize">18sp</item>
                <item name="android:textColor">@color/md_theme_light_primary</item>
                <item name="android:fontFamily">sans-serif</item>
        </style>

        <!-- Button Styles -->
        <style name="Widget.Material3.Button" parent="Widget.MaterialComponents.Button">
                <item name="backgroundTint">@color/md_theme_light_primary</item>
                <item name="android:textColor">@color/md_theme_light_onPrimary</item>
                <item name="android:fontFamily">sans-serif-medium</item>
        </style>

        <style name="Theme.MyApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
                <!-- Primary branding color. -->
                <item name="colorPrimary">@color/purple_500</item>
                <item name="colorPrimaryVariant">@color/purple_700</item>
                <item name="colorOnPrimary">@color/white</item>
                <!-- Secondary branding color. -->
                <item name="colorSecondary">@color/teal_200</item>
                <item name="colorSecondaryVariant">@color/teal_700</item>
                <item name="colorOnSecondary">@color/black</item>
                <!-- Status bar color. -->
                <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
                <!-- Customize your theme here. -->
        </style>


</resources>
